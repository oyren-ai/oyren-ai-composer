# Every version the sandbox image pins, in one place.
#
# The installers under deploy/ source this file (deploy/lib/versions.sh) instead of carrying their
# own defaults, and deploy/manifest/manifest.mjs turns it into the image manifest that stamps a bake
# and lets a live droplet work out which components a newer bake changed. Bump one line, re-bake,
# and `oyren update --check` on a running Codespace names exactly that component.
#
# KEY=VALUE only, no quotes, no spaces. An exported variable of the same name wins over this file.

NODE_MAJOR=24
PNPM_VERSION=10.33.0

# Agent CLIs (pnpm-global) and the DeepSeek Harness (its own project under /opt/oyren-dsh).
CLAUDE_VERSION=2.1.235
CODEX_VERSION=0.142.0
CODEX_ACP_VERSION=1.1.2
GEMINI_VERSION=0.50.0
OPENCODE_VERSION=1.17.18
QWEN_VERSION=0.19.9
DSH_VERSION=0.1.0-rc.7
ANTIGRAVITY_ACP_VERSION=1.0.0
PLAYWRIGHT_MCP_VERSION=0.0.78
BUN_VERSION=bun-v1.3.14

# The browser editor (our openvscode fork) and the streamed-Zed stack.
OPENVSCODE_VERSION=1.109.5-oyren.3
KASMVNC_VERSION=1.5.0
ZED_VERSION=1.15.0

# Bumped when the in-place updater's contract changes; an updater refuses a manifest newer than it.
UPDATER_PROTOCOL=1
