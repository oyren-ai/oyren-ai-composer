# The in-VM browser: KasmVNC's X server + openbox + Chrome, one supervised stack, streamed to the
# user through the sandbox router (/_oyren/browser/<token>/ → 127.0.0.1:6091).
#
# ON-DEMAND, unlike oyren-zed.service: no [Install] section AND no Wants= from oyren-sandbox.service,
# because a browser costs ~300MB resident and most sessions never need one. `oyren-open <url>` (the
# $BROWSER hook every CLI consults) starts it, which means the first `codex login` or `claude auth
# login` in a session brings it up exactly when it is needed.
#
# A viewer disconnect must never touch it — the launcher pins Xvnc's MaxDisconnectionTime /
# MaxIdleTime / MaxConnectionTime to 0, so closing the tab mid-login only drops the WebSocket while
# the half-finished sign-in stays on screen.
#
# The ONE deliberate exception is the idle timeout (idleWatch.mjs): after OYREN_BROWSER_IDLE_MINUTES
# (default 30) with no viewer socket at all, the launcher exits 0 and this unit stays down — a
# stopped browser is cheap to resume because Chrome's profile is on disk, so a completed login
# survives it. That is also why the timeout is decided in the launcher rather than by KasmVNC's own
# -MaxIdleTime: KasmVNC would kill Xvnc, Restart=on-failure below would read that as a crash, and
# the "timeout" would become a respawn loop.
[Unit]
Description=Oyren in-VM browser (KasmVNC + openbox + Chrome)
After=network-online.target
ConditionPathExists=/etc/oyren/sandbox.env

[Service]
# host.env is baked (PATH, locale); sandbox.env is per-session from cloud-init and carries
# CONTAINER_ENV_B64, which the launcher decodes (SESSION_TOKEN, OYREN_PUBLIC_ORIGIN).
EnvironmentFile=/etc/oyren/host.env
EnvironmentFile=/etc/oyren/sandbox.env
ExecStart=/usr/bin/node /usr/local/lib/oyren/start-browser.mjs

User=oyren
WorkingDirectory=/workspace
# A User= service has no logind session, so no /run/user/<uid>. Chrome needs an XDG_RUNTIME_DIR.
RuntimeDirectory=oyren-browser
RuntimeDirectoryMode=0700

# mixed: `systemctl stop` SIGTERMs only the launcher, whose handler shuts the children down in order
# and exits 0 — control-group would race the children's exit events against that handler.
KillMode=mixed

# on-failure, not always: a clean gate exit (no SESSION_TOKEN) must stay down; a dead Xvnc, openbox
# or Chrome exits 1 and restarts the whole stack — a crashed browser mid-login should come back.
Restart=on-failure
RestartSec=3
