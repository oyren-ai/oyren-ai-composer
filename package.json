{
  "name": "@oyren-ai/oyren-ai-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server that launches user-supplied scripts in disposable containers.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "sandbox": "tsx src/sandbox/main.ts",
    "buildjob": "tsx src/buildjob/main.ts",
    "edge": "tsx src/edge/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dockerode": "^4.0.2",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "tsx": "^4.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
