{
  "name": "@oyren-ai/oyren-ai-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox droplet infrastructure: session runtime, browser editor, and the DO snapshot bake/edge services for oyren.ai.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sandbox": "tsx src/sandbox/main.ts",
    "buildjob": "tsx src/buildjob/main.ts",
    "edge": "tsx src/edge/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "express": "^5.2.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
