# Bearer token AI clients must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
SCRIPT_RUNNER_TOKEN=

# HTTP port the MCP server listens on (Caddy proxies to this).
PORT=3000

# Host+container path where task workspaces and logs live.
# MUST be identical in the app container and on the host (sibling-container bind mounts).
TASKS_DIR=/srv/script-runner/tasks

# Concurrency + limits.
MAX_CONCURRENT=8
DEFAULT_TIMEOUT_SECONDS=300
# Upper bound a caller may request (30 min). Raise here + restart if a task needs more.
MAX_TIMEOUT_SECONDS=1800
MAX_ZIP_MB=25

# Per-task memory: default cap, and the hard ceiling a caller may request (2x).
TASK_MEMORY_MB=4096
TASK_MAX_MEMORY_MB=8192
TASK_CPUS=2
TASK_PIDS_LIMIT=256

# Isolated bridge network for task containers (internet access, no app access).
TASK_NETWORK=script-runner-tasks

# How long finished task dirs are kept before GC.
TASK_TTL_SECONDS=86400
