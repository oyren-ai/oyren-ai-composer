# Development Environment Configuration
# Copy this file to dev.tfvars and fill in your values
# IMPORTANT: Never commit dev.tfvars to git!

# DigitalOcean API Token (required)
# Get this from: https://cloud.digitalocean.com/account/api/tokens
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Project Configuration
project_name = "oyren-composer"
environment  = "dev"
region       = "nyc3"

# Network Configuration
vpc_cidr        = "10.10.0.0/16"
ssh_allowed_ips = ["0.0.0.0/0", "::/0"]  # Restrict this in production!

# Compute Configuration
droplet_count = 1
droplet_size  = "s-1vcpu-1gb"  # $6/month
droplet_image = "ubuntu-22-04-x64"

# SSH Keys (get IDs from: doctl compute ssh-key list)
ssh_key_ids = []  # e.g., ["12345678", "87654321"]

# Backups (disabled for dev to save costs)
enable_backups = false

# Storage (optional)
enable_volume = false
volume_size   = 10  # GB

# Spaces/S3 Storage (optional)
enable_spaces       = false
spaces_bucket_name  = ""  # e.g., "oyren-composer-dev-data"

# DNS (optional)
enable_dns     = false
domain_name    = ""  # e.g., "oyren.ai"
create_domain  = false
dns_subdomain  = "composer-dev"
