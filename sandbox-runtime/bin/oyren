#!/usr/bin/env node
// The in-terminal CLI (`oyren …`). The commands live in src/cli/; this file is the repo-local entry.
// install-runtime.sh installs /usr/local/bin/oyren as a shim that requires /app/src/cli/main.js
// instead of copying this file, so the installed command always follows the active runtime.
require(require("path").join(__dirname, "..", "src", "cli", "main.js"))
