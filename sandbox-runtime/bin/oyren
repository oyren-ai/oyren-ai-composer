#!/usr/bin/env node
// In-terminal CLI the agent or human runs to deploy their app. It talks to the local control API
// (127.0.0.1:$PORT/_oyren/control/*) using CONTROL_TOKEN from the container env — the same surface
// the orchestrator drives, so both paths stay in sync.
//
//   oyren expose <port>                          point the public URL at your app
//   oyren start [port]                           run your app via the manifest's start command
//   oyren restart                                restart the managed app
//   oyren stop                                   stop the managed app
//   oyren status                                 show app status
//   oyren route add <prefix> <port> [label]      add a reverse proxy route
//   oyren route remove <prefix>                  remove a route
//   oyren route list                             list all configured routes
const http = require("http")

const [,, cmd, ...rest] = process.argv
const ACTIONS = new Set(["expose", "start", "restart", "stop", "status", "route"])

if (!ACTIONS.has(cmd)) {
  console.error(`usage:
  oyren expose <port>                          route the public URL → your app
  oyren start [port]                           run via oyren manifest start command
  oyren restart                                restart the managed app
  oyren stop                                   stop the managed app
  oyren status                                 show app status
  oyren route add <prefix> <port> [label]      add a reverse proxy route
  oyren route remove <prefix>                  remove a route
  oyren route list                             list all configured routes`)
  process.exit(1)
}

// --- Route subcommand handling ---
if (cmd === "route") {
  const [subCmd, ...subArgs] = rest

  if (subCmd === "add") {
    const [prefix, portStr, ...labelParts] = subArgs
    const port = Number(portStr)
    if (!prefix || !port) {
      console.error("usage: oyren route add <prefix> <port> [label]")
      console.error('  e.g. oyren route add /studio 3000 "Remotion Studio"')
      process.exit(1)
    }
    const label = labelParts.join(" ")
    callControl("route/add", { prefix, port, label })
  } else if (subCmd === "remove" || subCmd === "rm") {
    const prefix = subArgs[0]
    if (!prefix) {
      console.error("usage: oyren route remove <prefix>")
      process.exit(1)
    }
    callControl("route/remove", { prefix })
  } else if (subCmd === "list" || subCmd === "ls" || !subCmd) {
    callControl("route/list", {})
  } else {
    console.error("unknown route subcommand: " + subCmd)
    console.error("usage: oyren route {add|remove|list}")
    process.exit(1)
  }
} else {
  // --- Legacy single-action commands ---
  if (cmd === "expose" && !Number(rest[0])) {
    console.error("oyren expose: a numeric <port> is required, e.g. `oyren expose 3000`")
    process.exit(1)
  }
  const payload = cmd === "expose" || (cmd === "start" && rest[0]) ? { port: Number(rest[0]) } : {}
  callControl(cmd, payload)
}

function callControl(action, payload) {
  const port = Number(process.env.PORT || 8080)
  const token = process.env.CONTROL_TOKEN || ""
  const body = JSON.stringify(payload)

  const req = http.request(
    {
      host: "127.0.0.1",
      port,
      method: "POST",
      path: `/_oyren/control/${action}`,
      headers: { "content-type": "application/json", "x-oyren-control-token": token, "content-length": Buffer.byteLength(body) },
    },
    (res) => {
      let data = ""
      res.on("data", (d) => (data += d))
      res.on("end", () => {
        if (action === "route/list" && res.statusCode < 300) {
          printRouteTable(data)
        } else {
          console.log(data || "{}")
        }
        process.exit(res.statusCode >= 300 ? 1 : 0)
      })
    },
  )
  req.on("error", (e) => { console.error("oyren: control server unreachable:", e.message); process.exit(1) })
  req.end(body)
}

function printRouteTable(jsonStr) {
  try {
    const { routes } = JSON.parse(jsonStr)
    if (!routes || !routes.length) {
      console.log("No routes configured. Add one with: oyren route add <prefix> <port> [label]")
      return
    }
    console.log("PREFIX          PORT   LABEL")
    console.log("─".repeat(50))
    for (const r of routes) {
      const prefix = (r.prefix || "/").padEnd(16)
      const port = String(r.port).padEnd(7)
      const label = r.label || ""
      console.log(`${prefix}${port}${label}`)
    }
  } catch {
    console.log(jsonStr)
  }
}
